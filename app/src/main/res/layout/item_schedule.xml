<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
    <View android:id="@+id/colorDot" android:layout_width="12dp" android:layout_height="12dp"
        android:layout_marginEnd="12dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#222222"/>
        <TextView android:id="@+id/tvRange" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#888888"/>
    </LinearLayout>
</LinearLayout>
