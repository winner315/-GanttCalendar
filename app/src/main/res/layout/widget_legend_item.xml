<?xml version="1.0" encoding="utf-8"?>
<!-- 图例项 = 色块 + 事件标题，标题过长时省略 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingEnd="4dp">

    <FrameLayout android:id="@+id/legendDot"
        android:layout_width="8dp" android:layout_height="8dp"
        android:layout_marginEnd="3dp"/>

    <TextView android:id="@+id/legendText"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:maxLines="1" android:ellipsize="end"
        android:textSize="8sp" android:textColor="@color/legendText"/>
</LinearLayout>
