# 端到端验收专用配置（复制为 web/.env.e2e）
#
# ！！DB_NAME 必须以 _e2e 结尾 ！！
# e2e 脚本第一件事就是清空 schedule 表，并且带一道硬闸门：
# 库名不匹配 *_e2e 时直接拒绝启动，防止误删你的真实排期。
# 环境变量优先：DB_NAME=gantt_calendar_e2e npm run e2e 会覆盖本文件的值。

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 与真实 .env 用同一个账号密码；这两项一般不用改
DB_PASSWORD=
DB_NAME=gantt_calendar_e2e
DB_SSL=0

# e2e 用独占端口，避免撞上 5174 / 8010 上正在跑的真实实例
API_PORT=8011

# e2e 会自己拉起前端（npm run dev），端口固定 5184；
# 要改就设环境变量 E2E_VITE_PORT，这里写 E2E_BASE 没用（脚本自己算地址）。
