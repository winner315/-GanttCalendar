# 排期甘特图 —— 后端数据库配置
# 复制本文件为 web/.env 后填写。.env 已被 .gitignore 忽略，不会误提交。

# ---------- MySQL 连接（必填） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root

# 密码可以为空（本机 MySQL 常见）。留空即为空密码，不是"未配置"。
DB_PASSWORD=

# 你已有的数据库名。库要先存在；表 schedule 由 server/migrate.py 建，不必手工建
# （.venv\Scripts\python.exe -m server.migrate，幂等，可重复跑）。
DB_NAME=gantt_calendar

# ---------- 可选 ----------
# 走 TLS 连接（MySQL 8 的 caching_sha2_password 在无 TLS 时需要 RSA 公钥交换；
# 若握手失败可置 1 绕开）。取值 1/0，默认 0。
DB_SSL=0

# 后端监听端口。改动后需同步改 vite.config.js 的 proxy 目标。
API_PORT=8010
